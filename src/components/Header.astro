
---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a class="brand" href="/">
      <span class="brand-icon">P</span>
      <span>Pentest<span class="brand-green">Blueprint</span></span>
    </a>

    <div class="internal-links">
      <HeaderLink href="/lab-writeups">Lab Writeups</HeaderLink>
      <HeaderLink href="/tools-techniques">Tools &amp; Techniques</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    position: relative;
    z-index: 10;
    margin: 0;
    padding: 0 1.5rem;
    background: #080b0a;
    border-bottom: 1px solid #202b24;
  }

  nav {
    max-width: 1160px;
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f0f4ef;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.6px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: #9cff57;
    color: #080b0a;
    font-size: 20px;
    font-weight: 900;
  }

  .brand-green {
    color: #9cff57;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .internal-links a {
    padding: 26px 0;
    color: #a0aaa2;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: color 0.2s, border-color 0.2s;
  }

  .internal-links a:hover {
    color: #9cff57;
  }

  .internal-links a.active {
    color: #9cff57;
    border-bottom-color: #9cff57;
  }

  @media (max-width: 600px) {
    header {
      padding: 0 1rem;
    }

    nav {
      min-height: 70px;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0;
      padding-top: 12px;
    }

    .brand {
      width: 100%;
      justify-content: center;
    }

    .internal-links {
      width: 100%;
      justify-content: center;
      gap: 22px;
    }

    .internal-links a {
      padding: 12px 0;
      font-size: 12px;
    }
  }
</style>
