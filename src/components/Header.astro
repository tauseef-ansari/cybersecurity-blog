
---
---

<header class="site-header">
  <nav class="header-inner" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="PentestBlueprint home">
      <span class="brand-icon" aria-hidden="true">
        P<span>.</span>
      </span>

      <span class="brand-name">
        Pentest<span class="brand-lime">Blueprint</span>
        <small>FIELD NOTES FROM THE LAB</small>
      </span>
    </a>

    <a class="vault-link" href="/vault/login" aria-label="Open private Vault">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span>Vault</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #071326;
    border-bottom: 1px solid #ffffff1c;
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: min(1400px, calc(100% - 96px));
    min-height: 104px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f3f6fc;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.8px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding-right: 4px;
    box-sizing: border-box;
    border: 1px solid #a6ff6460;
    border-radius: 13px;
    background: #a6ff64;
    color: #071326;
    box-shadow: 0 4px 0 #a6ff6420;
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -4px;
  }

  .brand-icon span {
    color: #376526;
  }

  .brand-lime {
    color: #a6ff64;
  }

  .brand-name small {
    display: block;
    margin-top: 3px;
    color: #afbdd1;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 2px;
  }

  .vault-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 10px 16px;
    border: 1px solid #a6ff6440;
    border-radius: 9px;
    background: #a6ff640a;
    color: #c9d7cb;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s, background .2s, border-color .2s;
  }

  .vault-link svg {
    color: #a6ff64;
    flex-shrink: 0;
  }

  .vault-link:hover {
    color: #a6ff64;
    background: #a6ff6415;
    border-color: #a6ff6480;
  }

  .brand:focus-visible,
  .vault-link:focus-visible {
    outline: 3px solid #a6ff64;
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 1100px) {
    .header-inner {
      width: calc(100% - 64px);
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: calc(100% - 40px);
      min-height: 0;
      padding: 20px 0;
    }

    .brand {
      font-size: 18px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
    }

    .brand-name small {
      font-size: 7px;
      letter-spacing: 1px;
    }

    .vault-link {
      padding: 10px;
    }

    .vault-link span {
      display: none;
    }
  }
</style>
