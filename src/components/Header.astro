
---
---

<header class="site-header">
  <nav class="header-inner" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="PentestBlueprint home">
      <span class="brand-icon" aria-hidden="true">
        P<span>.</span>
      </span>

      <span class="brand-name">
        Pentest<span class="brand-lime">Blueprint</span>
        <small>FIELD NOTES FROM THE LAB</small>
      </span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #071326;
    border-bottom: 1px solid #ffffff1c;
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: min(1400px, calc(100% - 96px));
    min-height: 104px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #f3f6fc;
    font-size: 20px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.8px;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding-right: 4px;
    box-sizing: border-box;
    border: 1px solid #a6ff6460;
    border-radius: 13px;
    background: #a6ff64;
    color: #071326;
    box-shadow: 0 4px 0 #a6ff6420;
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -4px;
  }

  .brand-icon span {
    color: #376526;
  }

  .brand-lime {
    color: #a6ff64;
  }

  .brand-name small {
    display: block;
    margin-top: 3px;
    color: #afbdd1;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 9px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 2px;
  }

  .brand:focus-visible {
    outline: 3px solid #a6ff64;
    outline-offset: 6px;
    border-radius: 4px;
  }

  @media (max-width: 1100px) {
    .header-inner {
      width: calc(100% - 64px);
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: calc(100% - 40px);
      min-height: 0;
      padding: 20px 0;
    }

    .brand {
      font-size: 18px;
    }
  }
</style>
