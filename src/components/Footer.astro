
---
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-content">
		<div class="brand">
			<span class="brand-icon">P</span>
			<span>Pentest<span class="green">Blueprint</span></span>
		</div>

		<p class="tagline">Think. Enumerate. Exploit. Document.</p>

		<p class="description">
			Documenting hands-on cybersecurity labs, penetration testing
			methodologies, tools, and technical research.
		</p>

		<div class="footer-links">
			<a href="/lab-writeups">Lab Writeups</a>
			<a href="/tools-techniques">Tools &amp; Techniques</a>
			<a href="https://github.com/tauseef-ansari" target="_blank" rel="noopener noreferrer">
				GitHub
			</a>
		</div>

		<div class="copyright">
			© {year} PentestBlueprint. All rights reserved.
		</div>
	</div>
</footer>

<style>
	footer {
		background: #080b0a;
		border-top: 1px solid #202b24;
		padding: 48px 20px 28px;
		color: #a0aaa2;
		text-align: center;
	}

	.footer-content {
		max-width: 850px;
		margin: 0 auto;
	}

	.brand {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		color: #f0f4ef;
		font-size: 19px;
		font-weight: 800;
	}

	.brand-icon {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 7px;
		background: #9cff57;
		color: #080b0a;
		font-size: 20px;
	}

	.green {
		color: #9cff57;
	}

	.tagline {
		margin: 16px 0 8px;
		color: #9cff57;
		font-size: 13px;
		font-weight: 600;
	}

	.description {
		max-width: 520px;
		margin: 0 auto;
		font-size: 13px;
		line-height: 1.7;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 24px;
		margin: 28px 0;
	}

	.footer-links a {
		color: #a0aaa2;
		font-size: 13px;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: #9cff57;
	}

	.copyright {
		padding-top: 22px;
		border-top: 1px solid #202b24;
		font-size: 12px;
		color: #68736a;
	}

	@media (max-width: 500px) {
		.footer-links {
			gap: 16px;
		}
	}
</style>
