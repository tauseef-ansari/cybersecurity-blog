---
export const prerender = false;
import { COOKIE_NAME, validSession } from '../../lib/vault-auth';
import { listEntries, getEntry } from '../../lib/vault-store';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
if (!(await validSession(Astro.cookies.get(COOKIE_NAME)?.value))) return Astro.redirect('/vault/login');
const entries = (await listEntries()).sort((a,b) => a.path.localeCompare(b.path));
const url = new URL(Astro.request.url);
const id = url.searchParams.get('id') || '';
const selected = /^[0-9a-f-]{36}$/.test(id) ? await getEntry(id) : null;
const imported = url.searchParams.get('imported');
const folders = [...new Set(entries.map(e => e.path.includes('/') ? e.path.split('/').slice(0,-1).join('/') : 'Root'))];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/>
<title>Private Knowledge Vault | PentestBlueprint</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#080b0a;color:#f0f4ef;font-family:Arial,Helvetica,sans-serif}main{max-width:1180px;margin:auto;padding:32px 20px 80px}header{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.brand{color:#9cff57;font-size:12px;font-weight:bold;letter-spacing:1.5px}h1{font-size:clamp(28px,4vw,42px);margin:32px 0 8px}p{color:#a0aaa2;line-height:1.6}.layout{display:grid;grid-template-columns:330px minmax(0,1fr);gap:20px;margin-top:24px}.panel{background:#101612;border:1px solid #263329;border-radius:12px;padding:22px;min-width:0}.panel h2{font-size:18px;margin:0 0 16px}.search,input[type=file]{width:100%;background:#080b0a;border:1px solid #344338;border-radius:8px;padding:12px;color:#f0f4ef}.folder{color:#9cff57;font-size:12px;margin:22px 0 9px;word-break:break-all}.file{display:block;padding:10px;border-radius:7px;color:#d4e4d6;text-decoration:none;font-size:13px;word-break:break-word}.file:hover,.file.active{background:#1d3021;color:#9cff57}.muted{font-size:12px;color:#a0aaa2}.content{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.75 ui-monospace,Consolas,monospace;background:#080d0b;border:1px solid #263329;padding:20px;border-radius:8px;max-height:70vh;overflow:auto}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}button,.btn{background:#9cff57;color:#080b0a;border:0;border-radius:8px;padding:11px 16px;font-weight:bold;cursor:pointer;text-decoration:none;font-size:13px}.outline{background:transparent;color:#9cff57;border:1px solid #344338}.success{color:#9cff57}.upload{border-bottom:1px solid #263329;padding-bottom:22px;margin-bottom:20px}.upload button{margin-top:10px}.item[hidden]{display:none}.note{margin-top:10px;color:#a0aaa2;font-size:12px}.filename{overflow-wrap:anywhere} @media(max-width:800px){.layout{grid-template-columns:1fr}}
</style>
</head>
<body><main>
<header><strong class="brand">PENTESTBLUEPRINT / PRIVATE VAULT</strong><form method="POST" action="/vault/logout"><button class="outline" type="submit">Log out</button></form></header>
<h1>Knowledge <span style="color:#9cff57">Vault.</span></h1>
<p>Your private lab notes, Notion exports, and attachments. Files are stored on the server, not in the public website.</p>
{imported && <p class="success">Imported {imported} files successfully.</p>}
<div class="layout">
<aside class="panel">
  <div class="upload"><h2>Import knowledge</h2><form action="/vault/api/upload" method="POST" enctype="multipart/form-data"><input type="file" name="file" accept=".zip,.md,.markdown,.txt" required/><button type="submit">Import file</button></form><p class="note">Notion ZIP or Markdown/text file, up to 8 MB. Supported attachments inside ZIP: images and PDF. Keep sensitive secrets out of notes unless necessary.</p></div>
  <h2>Browse library <span class="muted">({entries.length})</span></h2>
  <input class="search" id="search" type="search" placeholder="Search filenames and folders…" aria-label="Search library" />
  {entries.length === 0 ? <p>No notes yet. Import a Notion ZIP to begin.</p> : folders.map(folder => (
    <section class="folder-section"><div class="folder">▸ {folder}</div>
    {entries.filter(e => (e.path.includes('/') ? e.path.split('/').slice(0,-1).join('/') : 'Root') === folder).map(e => (
      <a class:list={['file','item',{'active':selected?.id===e.id}]} href={`/vault?id=${encodeURIComponent(e.id)}`} data-name={e.path.toLowerCase()}>{e.kind === 'markdown' ? '📄' : '📎'} {e.path.split('/').pop()}</a>
    ))}</section>
  ))}
</aside>
<section class="panel">
  {selected ? <>
    <h2 class="filename">{selected.path}</h2><p class="muted">{selected.kind === 'markdown' ? 'Markdown / text note' : 'Attachment'} · {Math.round(selected.size / 1024)} KB</p>
    {selected.kind === 'markdown' ? <div class="content">{selected.content}</div> : <p>Attachment preview is disabled for safety. Download to view.</p>}
    <div class="actions"><a class="btn" href={`/vault/api/file?id=${encodeURIComponent(selected.id)}`}>Download</a><form action="/vault/api/delete" method="POST" onsubmit="return confirm('Delete this file permanently?')"><input type="hidden" name="id" value={selected.id}/><button class="outline" type="submit">Delete</button></form></div>
  </> : <><h2>Choose a note</h2><p>Select any note from the library to read it here. Your Markdown is displayed as plain text to avoid executing embedded HTML or scripts.</p></>}
</section>
</div>
</main>
<script>
const search=document.querySelector<HTMLInputElement>('#search');
search?.addEventListener('input',()=>{
 const q=search.value.toLowerCase().trim();
 document.querySelectorAll<HTMLElement>('.item').forEach(e=>e.hidden=!(e.dataset.name||'').includes(q));
 document.querySelectorAll<HTMLElement>('.folder-section').forEach(e=>{e.hidden=!Array.from(e.querySelectorAll<HTMLElement>('.item')).some(x=>!x.hidden)});
});
</script>
</body></html>
