
---
export const prerender = false;

import {
  COOKIE_NAME,
  cookieOptions,
  createSession,
  validCredentials,
  validSession,
} from "../../lib/vault-auth";
import { loginAllowed, recordFailure, clearFailures } from "../../lib/vault-limit";

Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

if (await validSession(Astro.cookies.get(COOKIE_NAME)?.value)) {
  return Astro.redirect("/vault");
}

let error = "";

if (Astro.request.method === "POST") {
  const origin = Astro.request.headers.get("origin");
  const expectedOrigin = new URL(Astro.request.url).origin;
  const type = Astro.request.headers.get("content-type") || "";

  if (origin !== expectedOrigin || !type.includes("application/x-www-form-urlencoded")) {
    return new Response("Forbidden", { status: 403 });
  }

  const body = await Astro.request.text();

  if (body.length > 4096) {
    return new Response("Request too large", { status: 413 });
  }

  const data = new URLSearchParams(body);
  const username = data.get("username") || "";
  const password = data.get("password") || "";

  const ip = Astro.clientAddress || Astro.request.headers.get("x-nf-client-connection-ip") || "unknown";
  if (!(await loginAllowed(ip))) return new Response("Too many attempts. Try again in 15 minutes.", { status: 429 });

  if (validCredentials(username, password)) {
    await clearFailures(ip);
    Astro.cookies.set(COOKIE_NAME, await createSession(), cookieOptions);
    return Astro.redirect("/vault", 303);
  }

  await recordFailure(ip);
  error = "Invalid username or password.";
  Astro.response.status = 401;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Vault Login | PentestBlueprint</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #080b0a;
        color: #f0f4ef;
        font-family: Arial, Helvetica, sans-serif;
        padding: 24px;
      }
      .panel {
        width: 100%;
        max-width: 420px;
        background: #101612;
        border: 1px solid #263329;
        border-radius: 16px;
        padding: 36px;
      }
      .eyebrow {
        color: #9cff57;
        font-size: 12px;
        font-weight: bold;
        letter-spacing: 2px;
      }
      h1 { font-size: 29px; margin: 16px 0 8px; }
      p { color: #a0aaa2; line-height: 1.6; }
      label { display: block; margin: 20px 0 8px; font-size: 14px; }
      input {
        width: 100%;
        background: #080b0a;
        border: 1px solid #344338;
        color: white;
        border-radius: 8px;
        padding: 14px;
        font-size: 15px;
      }
      input:focus { outline: 2px solid #9cff57; }
      button {
        width: 100%;
        margin-top: 28px;
        background: #9cff57;
        border: none;
        border-radius: 8px;
        padding: 14px;
        font-weight: bold;
        font-size: 15px;
        cursor: pointer;
        color: #080b0a;
      }
      .error { color: #ff8585; }
      a { display: block; text-align: center; margin-top: 24px; color: #a0aaa2; }
    </style>
  </head>
  <body>
    <main class="panel">
      <div class="eyebrow">PENTESTBLUEPRINT / RESTRICTED</div>
      <h1>Private Vault</h1>
      <p>Authenticate to access your personal offensive security knowledge base.</p>

      {error && <p class="error" role="alert">{error}</p>}

      <form method="POST" action="/vault/login">
        <label for="username">Administrator username</label>
        <input id="username" name="username" autocomplete="username" required maxlength="100" />

        <label for="password">Password</label>
        <input id="password" name="password" type="password"
          autocomplete="current-password" required maxlength="256" />

        <button type="submit">Unlock Vault</button>
      </form>

      <a href="/">Return to PentestBlueprint</a>
    </main>
  </body>
</html>

