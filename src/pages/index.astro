---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);
const latest = posts[0];
const postUrl = (id: string) => `/blog/${id}/`;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071326" />
    <meta name="description" content="The flag is only the ending. Follow the whole story: practical cybersecurity labs, Active Directory attack paths, and lessons from PentestBlueprint." />
    <title>PentestBlueprint | The flag is only the ending.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="navbar wrap">
      <a class="brand" href="/" aria-label="PentestBlueprint home">
        <span class="brand-icon" aria-hidden="true">P<span>.</span></span>
        <span class="brand-name">Pentest<span>Blueprint</span><small>FIELD NOTES FROM THE LAB</small></span>
      </a>

    </header>

    <main id="main">
      <section class="hero-band" aria-labelledby="hero-heading">
        <div class="hero wrap">
          <div class="hero-copy">
            <p class="pill"><span class="dot" aria-hidden="true"></span> Curiosity. Enumeration. Discovery.</p>
            <h1 id="hero-heading">The flag is<br />only the <span class="ending">ending.</span><br /><span class="lime">Here’s the<br class="desktop-break" /> whole story.</span></h1>
            <p class="hero-description">The footholds, the dead ends, and the discoveries in between. Hands-on security labs, documented one attack path at a time.</p>
            <div class="hero-buttons">
              <a class="button primary" href="/lab-writeups">Explore lab writeups <span aria-hidden="true">↗</span></a>
            </div>
            {latest && (
              <a class="latest-link" href={postUrl(latest.id)}>
                <span class="latest-label"><span class="dot" aria-hidden="true"></span> LATEST WRITEUP</span>
                <span class="latest-title">{latest.data.title}</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          <div class="blueprint" aria-label="Illustrated lab methodology: enumerate, find a foothold, follow permissions, and document the path">
            <div class="blueprint-bar"><span><span class="dot" aria-hidden="true"></span> ATTACK PATH / FIELD NOTES</span><span>PB—01</span></div>
            <div class="blueprint-canvas" aria-hidden="true">
              <div class="orbital orbit-one"></div><div class="orbital orbit-two"></div>
              <div class="cross cross-one">+</div><div class="cross cross-two">+</div>
              <svg class="connections" viewBox="0 0 480 440" fill="none" preserveAspectRatio="none">
                <path d="M240 85V136H106V184M106 240V282H356V303M356 359V397H240" stroke="#a6ff64" stroke-width="2" stroke-dasharray="6 7" />
                <circle cx="240" cy="85" r="5" fill="#a6ff64" />
                <circle cx="240" cy="397" r="5" fill="#a6ff64" />
              </svg>
              <div class="path-node node-recon"><span class="node-number">01</span><div><small>ENUMERATE</small><strong>Find the details.</strong></div><span class="node-symbol">⌕</span></div>
              <div class="path-node node-shell"><span class="node-number">02</span><div><small>INITIAL ACCESS</small><strong>A foothold appears.</strong></div><span class="node-symbol">&gt;_</span></div>
              <div class="path-node node-domain"><span class="node-number">03</span><div><small>FOLLOW THE PERMISSIONS</small><strong>Connect the dots.</strong></div><span class="node-symbol">↗</span></div>
              <div class="path-note">The interesting part?<br /><span>Everything between the flags.</span></div>
            </div>
            <div class="blueprint-terminal"><span class="terminal-muted">~/pentestblueprint</span><p><span class="lime">$</span> document --the-whole-story<span class="cursor" aria-hidden="true"></span></p></div>
            <div class="blueprint-stamp"><span class="stamp-symbol" aria-hidden="true">✳</span><span>STAY CURIOUS.<br />FOLLOW THE PATH.</span></div>
          </div>
        </div>
      </section>

      <div class="method-band">
        <div class="method wrap" aria-label="My approach">
          <span><b>01 /</b> Think</span><span><b>02 /</b> Enumerate</span><span><b>03 /</b> Exploit</span><span><b>04 /</b> Document</span>
        </div>
      </div>

      <section class="writeups wrap section" aria-labelledby="writeups-heading">
        <div class="section-heading"><div><p class="eyebrow">THE NOTES BEHIND THE FLAGS</p><h2 id="writeups-heading">Fresh from <span class="lime">the lab.</span></h2></div><a class="text-link" href="/lab-writeups">All writeups <span aria-hidden="true">↗</span></a></div>
        {latestPosts.length > 0 ? (
          <div class="post-grid">
            {latestPosts.map((post, index) => (
              <a class="post-card" href={postUrl(post.id)}>
                <div class="card-art" aria-hidden="true">{post.data.heroImage ? (
                    <img class="card-cover" src={post.data.heroImage} alt={`${post.data.title} cover`} loading="lazy" decoding="async" />
                  ) : (
                    <><span class="card-grid"></span><span class="card-monogram">{post.data.category === 'Active Directory' ? 'AD' : post.data.category}</span></>
                  )}<span class="card-index">FIELD NOTE / {String(index + 1).padStart(2, '0')}</span><span class="card-arrow">↗</span></div>
                <div class="card-body"><div class="card-meta"><span>{post.data.category}</span><span class:list={['difficulty', post.data.difficulty.toLowerCase()]}>{post.data.difficulty}</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="card-footer"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>Read the story <span aria-hidden="true">→</span></span></div></div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state"><h3>The next story starts in the lab.</h3><p>Published writeups will appear here as they are added.</p><a class="text-link" href="/lab-writeups">Explore lab writeups →</a></div>
        )}
      </section>

      <section class="notebook-section wrap" aria-labelledby="notebook-heading">
        <div class="notebook-mark" aria-hidden="true"><span>PB / NOTES</span><strong>&gt;_</strong><small>LEARN. TEST. DOCUMENT.</small></div>
        <div class="notebook-copy"><p class="eyebrow">A PERSONAL SECURITY NOTEBOOK</p><h2 id="notebook-heading">More than commands.<br /><span class="lime">The thinking behind them.</span></h2><p>I’m Tauseef, and PentestBlueprint is where I document what I learn in cybersecurity labs: what worked, what didn’t, and why the next step made sense.</p><p>Expect practical walkthroughs, Active Directory attack paths, and technical notes that make the process easier to follow.</p></div>
      </section>

      <section class="closing wrap" aria-labelledby="closing-heading"><p class="eyebrow">ONE DISCOVERY AT A TIME</p><h2 id="closing-heading">Stay curious.<br /><span class="lime">There’s always another path.</span></h2><a class="button primary" href="/lab-writeups">Find your next read <span aria-hidden="true">→</span></a></section>
    </main>

    <footer class="footer wrap"><a class="brand" href="/"><span class="brand-icon" aria-hidden="true">P<span>.</span></span><span>Pentest<span class="lime">Blueprint</span></span></a><p>© {new Date().getFullYear()} PentestBlueprint · Built for curious minds.</p><a class="text-link" href="#main">Back to top ↑</a></footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; --bg: #071326; --panel: #0d1e36; --lime: #a6ff64; --text: #f3f6fc; --muted: #afbdd1; --border: #ffffff1c; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 24px; }
  body { margin: 0; padding: 0; width: 100%; background: var(--bg); color: var(--text); font-family: 'Inter', 'Segoe UI', Arial, sans-serif; font-size: 16px; line-height: 1.65; }
  h1,h2,h3,p { margin: 0; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--lime); outline-offset: 6px; border-radius: 4px; }
  ::selection { color: var(--bg); background: var(--lime); }
  .wrap { width: min(1400px, calc(100% - 96px)); margin-inline: auto; }
  .lime { color: var(--lime); }
  .skip-link { position: fixed; top: 12px; left: 12px; z-index: 5; padding: 12px 20px; background: var(--lime); color: var(--bg); transform: translateY(-180%); }
  .skip-link:focus { transform: none; }
  .navbar { min-height: 104px; display: flex; justify-content: space-between; align-items: center; gap: 28px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-size: 20px; font-weight: 800; letter-spacing: -.8px; }
  .brand-icon { width: 44px; height: 44px; display: inline-flex; justify-content: center; align-items: center; border: 1px solid #a6ff6460; border-radius: 13px; background: var(--lime); color: var(--bg); font-size: 29px; font-weight: 900; letter-spacing: -4px; padding-right: 4px; box-shadow: 0 4px 0 #a6ff6420; }
  .brand-icon span { color: #376526; }
  .brand-name > span { color: var(--lime); }
  .brand-name small { display: block; margin-top: 1px; font: 9px/1.5 ui-monospace, Consolas, monospace; letter-spacing: 2px; color: var(--muted); }
  .navbar nav { display: flex; gap: 34px; font-size: 14px; font-weight: 600; color: var(--muted); }
  .navbar nav a:hover, .text-link:hover { color: var(--lime); }
  main { display: block; width: 100%; max-width: none; margin: 0; padding: 0; }
  .hero-band { border-top: 1px solid var(--border); background: radial-gradient(ellipse at 85% 45%, #15396a60, transparent 60%), radial-gradient(#aec9ff20 1px, transparent 1px); background-size: auto, 26px 26px; }
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: center; padding-top: 68px; padding-bottom: 76px; }
  .hero-copy { min-width: 0; }
  .pill { display: inline-flex; gap: 10px; align-items: center; color: #c6d5e9; font: 11px/1.5 ui-monospace, Consolas, monospace; background: #12233bc9; border: 1px solid #ffffff25; border-radius: 30px; padding: 9px 15px; }
  .dot { display: inline-block; flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--lime); }
  .hero h1 { margin: 28px 0 26px; max-width: 760px; font-size: clamp(46px, 5.3vw, 80px); line-height: 1.05; letter-spacing: -.055em; font-weight: 800; }
  .ending { position: relative; display: inline-block; }
  .ending::after { content: ''; position: absolute; height: 5px; background: var(--lime); left: 2px; right: 0; bottom: -5px; transform: rotate(-3deg); border-radius: 50%; }
  .hero-description { max-width: 540px; color: #bdcce0; font-size: 17px; line-height: 1.8; }
  .hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 50px; padding: 13px 22px; border: 1px solid transparent; border-radius: 30px; font-size: 13px; font-weight: 750; transition: transform .2s, background .2s; }
  .button:hover { transform: translateY(-3px); }
  .primary { background: var(--lime); color: #10200b; }
  .primary:hover { background: #c0ff94; }
  .secondary { border-color: #ffffff35; background: #0b192b; }
  .secondary:hover { background: #152945; }
  .latest-link { display: flex; align-items: center; flex-wrap: wrap; gap: 9px 12px; max-width: 580px; margin-top: 26px; border-top: 1px solid var(--border); padding-top: 18px; font-size: 12px; }
  .latest-label { display: inline-flex; align-items: center; gap: 7px; color: var(--lime); font: 9px ui-monospace, monospace; letter-spacing: 1px; }
  .latest-label .dot { width: 5px; height: 5px; }
  .latest-title { flex: 1 1 200px; color: #d3deee; }
  .latest-link:hover .latest-title { text-decoration: underline; text-underline-offset: 4px; }
  .blueprint { position: relative; min-width: 0; border: 1px solid #7fa0ce45; border-radius: 20px; background: #0b1a30; box-shadow: 22px 24px 0 -8px #102645, 0 35px 90px #0004; transform: rotate(2deg); }
  .blueprint-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 19px; border-bottom: 1px solid #ffffff18; font: 9px ui-monospace, monospace; letter-spacing: 1px; color: #b8c8df; }
  .blueprint-bar > span:first-child { display: flex; align-items: center; gap: 9px; }
  .blueprint-canvas { position: relative; height: 440px; overflow: hidden; background-image: linear-gradient(#8aaff010 1px, transparent 1px), linear-gradient(90deg, #8aaff010 1px, transparent 1px); background-size: 24px 24px; }
  .connections { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbital { position: absolute; width: 330px; height: 330px; top: 55px; left: calc(50% - 165px); border: 1px solid #84a9e31c; border-radius: 50%; }
  .orbit-two { width: 240px; height: 240px; top: 100px; left: calc(50% - 120px); }
  .cross { position: absolute; color: #6b8bb266; font: 24px ui-monospace, monospace; }
  .cross-one { top: 20px; left: 22px; } .cross-two { bottom: 20px; right: 22px; }
  .path-node { position: absolute; display: flex; align-items: center; gap: 11px; padding: 17px 14px; background: #10233f; border: 1px solid #82a6da55; border-radius: 12px; box-shadow: 0 12px 25px #0003; }
  .node-recon { top: 35px; left: 24%; right: 7%; }
  .node-shell { top: 173px; left: 5%; right: 24%; }
  .node-domain { top: 300px; left: 22%; right: 4%; border-color: #a6ff6470; background: #132c35; }
  .node-number { display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0; border: 1px solid #a6ff6450; border-radius: 8px; color: var(--lime); font: 11px ui-monospace, monospace; }
  .path-node small { display: block; color: #b1c4de; font: 8px/1.5 ui-monospace, monospace; letter-spacing: 1px; }
  .path-node strong { display: block; margin-top: 4px; font-size: 14px; letter-spacing: -.3px; }
  .node-symbol { margin-left: auto; color: var(--lime); font: 20px ui-monospace, monospace; }
  .path-note { position: absolute; top: 100px; right: 5%; color: #89a7cb; font: 10px/1.8 ui-monospace, monospace; text-align: right; }
  .path-note span { color: var(--lime); }
  .blueprint-terminal { border-top: 1px solid var(--border); padding: 18px 22px 22px; font: 11px/1.8 ui-monospace, Consolas, monospace; }
  .terminal-muted { color: #91a8c7; font-size: 10px; }
  .cursor { display: inline-block; width: 6px; height: 13px; vertical-align: middle; margin-left: 6px; background: var(--lime); animation: blink 1.2s step-end infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .blueprint-stamp { position: absolute; right: -10px; bottom: -30px; display: flex; align-items: center; gap: 10px; background: var(--lime); color: #132408; padding: 13px 18px; border-radius: 10px; transform: rotate(-7deg); font: bold 9px/1.5 ui-monospace, monospace; box-shadow: 0 8px 30px #0004; }
  .stamp-symbol { font-size: 30px; }
  .method-band { border-block: 1px solid var(--border); background: #0a192e; }
  .method { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; padding-block: 24px; }
  .method > span { font-size: 14px; font-weight: 600; }
  .method b { color: var(--lime); margin-right: 14px; font: 10px ui-monospace, monospace; }
  .section { padding-block: 92px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .eyebrow { margin-bottom: 12px; color: var(--lime); font: 10px/1.5 ui-monospace, Consolas, monospace; letter-spacing: 1.6px; }
  h2 { font-size: clamp(29px, 3.1vw, 43px); line-height: 1.15; font-weight: 750; letter-spacing: -1.6px; }
  .text-link { display: inline-flex; align-items: center; gap: 14px; font-size: 13px; font-weight: 600; }
  .post-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .post-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 15px; background: #0c1b30; transition: transform .2s, border-color .2s; }
  .post-card:hover { transform: translateY(-6px); border-color: #a6ff6460; }
  .card-art { height: 180px; position: relative; overflow: hidden; background: radial-gradient(ellipse at 80% 70%, #2b52784f, transparent), #102644; }
  .post-card:nth-child(2) .card-art { background-color: #142d30; }
  .post-card:nth-child(3) .card-art { background-color: #242645; }
  .card-cover { display: block; width: 100%; height: 100%; object-fit: cover; }
  .card-art::after { content: ""; position: absolute; inset: 45% 0 0; background: linear-gradient(transparent, #07132699); pointer-events: none; }
  .card-grid { position: absolute; inset: 0; background-image: linear-gradient(#b4cbef12 1px,transparent 1px),linear-gradient(90deg,#b4cbef12 1px,transparent 1px); background-size: 22px 22px; transform: rotate(-12deg) scale(1.4); }
  .card-monogram { position: absolute; left: 24px; top: 14px; font: 700 clamp(30px, 4vw, 58px)/1.6 ui-monospace, monospace; color: #a6ff64be; letter-spacing: -3px; }
  .card-index { z-index: 1; position: absolute; left: 26px; bottom: 19px; color: #b6c9e1; font: 9px ui-monospace, monospace; letter-spacing: 1px; }
  .card-arrow { z-index: 1; position: absolute; top: 20px; right: 20px; color: var(--lime); font-size: 24px; }
  .card-body { display: flex; flex-direction: column; flex: 1; padding: 23px; }
  .card-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; color: #bdcce1; font: 10px ui-monospace, monospace; }
  .difficulty { padding: 3px 9px; border: 1px solid #ffffff26; border-radius: 20px; }
  .easy { color: var(--lime); background: #a6ff640c; border-color: #a6ff6430; }
  .medium { color: #ffe087; } .hard { color: #ffa6b2; }
  .post-card h3 { margin: 19px 0 12px; font-size: 21px; line-height: 1.35; letter-spacing: -.6px; }
  .post-card p { margin-bottom: 24px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .card-footer { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 16px; margin-top: auto; font-size: 10px; color: #a7b9d1; }
  .card-footer > span { color: var(--lime); }
  .empty-state { padding: 36px; border: 1px dashed #ffffff35; border-radius: 15px; }
  .empty-state p { margin: 12px 0; color: var(--muted); }
  .notebook-section { display: grid; grid-template-columns: .7fr 1.3fr; align-items: center; gap: 70px; padding: 56px; border: 1px solid var(--border); border-radius: 22px; background: #0c1c32; }
  .notebook-mark { display: flex; flex-direction: column; justify-content: space-between; width: 100%; max-width: 300px; min-height: 260px; margin-inline: auto; padding: 24px; border: 1px solid #a6ff6440; border-left: 8px solid var(--lime); border-radius: 6px 16px 16px 6px; transform: rotate(-5deg); background: repeating-linear-gradient(transparent 0 27px,#ffffff08 27px 28px),#0a192c; color: var(--lime); }
  .notebook-mark span,.notebook-mark small { font: 10px ui-monospace, monospace; letter-spacing: 1px; }
  .notebook-mark strong { font: 700 70px/1.2 ui-monospace, monospace; }
  .notebook-copy > p:not(.eyebrow) { max-width: 620px; margin-top: 20px; color: var(--muted); font-size: 14px; }
  .notebook-copy .text-link { margin-top: 24px; color: var(--lime); }
  .closing { text-align: center; padding-block: 100px; }
  .closing h2 { font-size: clamp(32px, 4vw, 54px); }
  .closing .button { margin-top: 28px; }
  .footer { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 24px; padding-block: 30px; border-top: 1px solid var(--border); }
  .footer .brand { font-size: 16px; }
  .footer .brand-icon { width: 32px; height: 32px; border-radius: 9px; font-size: 22px; }
  .footer p { color: #9eb0c9; font-size: 11px; }
  @media (min-width: 1700px) { .hero h1 { font-size: 85px; } }
  @media (max-width: 1100px) { .wrap { width: calc(100% - 64px); } .hero { gap: 36px; } .hero h1 { font-size: 56px; } .hero-description { font-size: 15px; } .path-node { padding: 14px 10px; gap: 8px; } .path-node strong { font-size: 12px; } .node-symbol { display: none; } .path-node small { font-size: 7px; } .blueprint-bar { font-size: 8px; padding: 16px; } .post-grid { gap: 16px; } .card-body { padding: 18px; } .notebook-section { gap: 40px; padding: 36px; } }
  @media (max-width: 850px) { .hero { grid-template-columns: 1fr; gap: 60px; padding-block: 48px 74px; } .hero h1 { font-size: clamp(50px,8vw,70px); } .desktop-break { display: none; } .hero-description { max-width: 620px; font-size: 17px; } .blueprint { width: min(500px,calc(100% - 20px)); margin-inline: auto; } .path-node strong { font-size: 14px; } .path-node small { font-size: 8px; } .node-symbol { display: block; } .post-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .notebook-section { grid-template-columns: 1fr; gap: 42px; padding: 36px; } .notebook-mark { min-height: 220px; max-width: 260px; } .notebook-copy { max-width: 600px; } }
  @media (max-width: 560px) { .wrap { width: calc(100% - 40px); } .navbar { padding-block: 20px; gap: 20px; } .brand { font-size: 18px; } .hero h1 { font-size: clamp(41px,10.5vw,58px); margin-block: 24px; } .pill { padding: 8px 10px; font-size: 9px; } .hero-description { font-size: 15px; } .hero-buttons { flex-direction: column; align-items: stretch; } .button { font-size: 13px; } .blueprint-bar { font-size: 7px; letter-spacing: .4px; padding: 14px 10px; } .blueprint-terminal { font-size: 9px; padding: 14px; } .blueprint-canvas { height: 410px; } .node-recon { top: 28px; left: 14%; right: 5%; } .node-shell { top: 160px; left: 4%; right: 15%; } .node-domain { top: 280px; left: 12%; right: 3%; } .path-node strong { font-size: 11px; } .path-node small { font-size: 7px; letter-spacing: .6px; } .node-number { width: 26px; height: 28px; } .node-symbol { font-size: 16px; } .path-note { top: 108px; font-size: 8px; } .blueprint-stamp { right: 0; font-size: 8px; padding: 10px 12px; } .method { grid-template-columns: repeat(2,1fr); gap: 18px; } .method > span { font-size: 12px; } .method b { margin-right: 8px; } .section { padding-block: 64px; } .section-heading { align-items: start; flex-direction: column; gap: 20px; } .post-grid { grid-template-columns: 1fr; } .card-art { height: 170px; } .card-monogram { font-size: 50px; } .card-body { padding: 23px; } .notebook-section { padding: 30px 22px; } h2 { letter-spacing: -1px; } .closing { padding-block: 74px; } .footer { gap: 20px; } .footer p { order: 3; width: 100%; } .footer .text-link { font-size: 11px; } }
