---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
  <head>
    <BaseHead
      title="Lab Writeups"
      description="Hands-on cybersecurity lab writeups covering AWS, web security, Linux, Windows and Active Directory."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="intro">
        <p class="eyebrow">PRACTICAL SECURITY RESEARCH</p>
        <h1>Lab <span>Writeups</span></h1>
        <p class="subtitle">
          Real-world labs. Practical exploitation. Documented methodology.
          Explore my hands-on cybersecurity research and technical findings.
        </p>
      </section>

      <section class="filters" aria-label="Filter lab writeups">
        <div class="filter-group">
          <label for="category-filter">Category</label>
          <select id="category-filter">
            <option value="all">All categories</option>
            <option value="AWS">AWS</option>
            <option value="Web">Web</option>
            <option value="Linux">Linux</option>
            <option value="Windows">Windows</option>
            <option value="Active Directory">Active Directory</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="difficulty-filter">Difficulty</label>
          <select id="difficulty-filter">
            <option value="all">All difficulties</option>
            <option value="Easy">Easy</option>
            <option value="Medium">Medium</option>
            <option value="Hard">Hard</option>
          </select>
        </div>
        <button id="reset-filters" type="button">Reset filters</button>
      </section>

      <div class="results-info" aria-live="polite">
        <span id="results-count">{sortedPosts.length} {sortedPosts.length === 1 ? 'writeup' : 'writeups'} found</span>
      </div>

      <section class="writeups-grid" id="writeups-grid" aria-label="Lab writeups">
        {sortedPosts.map((post) => (
          <article
            class="writeup-card"
            data-category={post.data.category}
            data-difficulty={post.data.difficulty}
          >
            {post.data.heroImage ? (
              <a class="card-image" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
                <img
                  src={post.data.heroImage}
                  alt={`${post.data.title} cover illustration`}
                  loading="lazy"
                  decoding="async"
                  width="720"
                  height="360"
                />
              </a>
            ) : (
              <div class="card-image card-image-fallback" aria-hidden="true">
                <span>{post.data.category === 'Active Directory' ? 'AD' : post.data.category}</span>
              </div>
            )}
            <div class="card-content">
              <div class="card-top">
                <span class="category">{post.data.category}</span>
                <span class={`difficulty ${post.data.difficulty.toLowerCase()}`}>
                  {post.data.difficulty}
                </span>
              </div>
              <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
              <p class="description">{post.data.description}</p>
              <div class="card-bottom">
                <time datetime={post.data.pubDate.toISOString()}>
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <a href={`/blog/${post.id}/`}>Read writeup →</a>
              </div>
            </div>
          </article>
        ))}
      </section>
      <p id="empty-message" hidden>No writeups match these filters. Try another combination.</p>
    </main>
    <Footer />

    <script>
      const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
      const difficultyFilter = document.querySelector<HTMLSelectElement>('#difficulty-filter');
      const resetButton = document.querySelector<HTMLButtonElement>('#reset-filters');
      const cards = document.querySelectorAll<HTMLElement>('.writeup-card');
      const resultsCount = document.querySelector<HTMLElement>('#results-count');
      const emptyMessage = document.querySelector<HTMLElement>('#empty-message');

      function filterWriteups() {
        const category = categoryFilter?.value ?? 'all';
        const difficulty = difficultyFilter?.value ?? 'all';
        let visibleCount = 0;
        cards.forEach((card) => {
          const matchesCategory = category === 'all' || card.dataset.category === category;
          const matchesDifficulty = difficulty === 'all' || card.dataset.difficulty === difficulty;
          const visible = matchesCategory && matchesDifficulty;
          card.hidden = !visible;
          if (visible) visibleCount++;
        });
        if (resultsCount) {
          resultsCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'writeup' : 'writeups'} found`;
        }
        if (emptyMessage) emptyMessage.hidden = visibleCount !== 0;
      }
      categoryFilter?.addEventListener('change', filterWriteups);
      difficultyFilter?.addEventListener('change', filterWriteups);
      resetButton?.addEventListener('click', () => {
        if (categoryFilter) categoryFilter.value = 'all';
        if (difficultyFilter) difficultyFilter.value = 'all';
        filterWriteups();
      });
    </script>
  </body>
</html>

<style>
  .intro { padding: 45px 0 35px; }
  .eyebrow { color: #9cff57; font-size: 12px; font-weight: 700; letter-spacing: 2px; }
  .intro h1 { margin: 12px 0; }
  .intro h1 span { color: #9cff57; }
  .subtitle { max-width: 650px; font-size: 16px; }
  .filters { display: flex; align-items: end; flex-wrap: wrap; gap: 18px; padding: 22px; background: #101612; border: 1px solid #263329; border-radius: 10px; }
  .filter-group { display: flex; flex-direction: column; gap: 8px; flex: 1; min-width: 180px; }
  .filter-group label { color: #a0aaa2; font-size: 12px; font-weight: 700; }
  select { width: 100%; padding: 12px; border: 1px solid #263329; border-radius: 6px; background: #080b0a; color: #f0f4ef; }
  button { padding: 12px 18px; border: 1px solid #9cff57; border-radius: 6px; background: transparent; color: #9cff57; cursor: pointer; }
  button:hover { background: #9cff57; color: #080b0a; }
  .results-info { margin: 25px 0 15px; color: #a0aaa2; font-size: 13px; }
  .writeups-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .writeup-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; background: #101612; border: 1px solid #263329; border-radius: 10px; transition: border-color .2s, transform .2s; }
  .writeup-card:hover { border-color: #9cff57; transform: translateY(-3px); }
  .writeup-card[hidden], #empty-message[hidden] { display: none; }
  .card-image { display: block; width: 100%; height: 205px; overflow: hidden; background: #080b0a; border-bottom: 1px solid #263329; }
  .card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .writeup-card:hover .card-image img { transform: scale(1.04); }
  .card-image-fallback { display: grid; place-items: center; background: radial-gradient(circle at 70% 30%, #244332, #080b0a 75%); }
  .card-image-fallback span { color: #9cff57; font: 800 44px ui-monospace, monospace; }
  .card-content { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 22px; }
  .card-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
  .category, .difficulty { padding: 5px 10px; border-radius: 4px; font-size: 11px; font-weight: 700; }
  .category { background: #1b2a1d; color: #9cff57; }
  .difficulty { background: #252525; color: #d0d0d0; }
  .difficulty.easy { color: #9cff57; }
  .difficulty.medium { color: #f4c95d; }
  .difficulty.hard { color: #ff7777; }
  .writeup-card h2 { margin: 0 0 10px; font-size: 20px; line-height: 1.35; }
  .writeup-card h2 a { color: inherit; text-decoration: none; }
  .writeup-card h2 a:hover, .card-bottom a:hover { color: #9cff57; }
  .description { flex: 1; font-size: 14px; }
  .card-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; padding-top: 15px; border-top: 1px solid #263329; font-size: 12px; }
  .card-bottom time { color: #a0aaa2; }
  .card-bottom a { font-weight: 700; }
  #empty-message { margin: 35px 0; text-align: center; }
  @media (max-width: 650px) {
    .writeups-grid { grid-template-columns: 1fr; }
    .intro { padding-top: 25px; }
    .card-image { height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .writeup-card, .card-image img { transition: none; }
  }

/* Compact Lab Writeups header */
.page-hero,
.hero,
.page-header {
  padding-top: 36px;
  padding-bottom: 28px;
  min-height: 0;
}

.page-hero h1,
.hero h1,
.page-header h1 {
  margin-top: 12px;
  margin-bottom: 12px;
}

.page-hero p,
.hero p,
.page-header p {
  margin-bottom: 0;
}

/* Bring filters and writeups closer */
.filters,
.filter-bar,
.filters-section {
  margin-top: 20px;
  margin-bottom: 24px;
}

/* Reduce excess vertical spacing */
main {
  padding-top: 20px;
}

@media (max-width: 600px) {
  .page-hero,
  .hero,
  .page-header {
    padding-top: 20px;
    padding-bottom: 20px;
  }
}

</style>
