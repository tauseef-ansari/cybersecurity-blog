---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const methods = [
  { id:'method-1', name:'Method 1 — NetExec', description:"Collect remotely from Linux using valid domain credentials and NetExec's BloodHound collection feature.", usage:"nxc ldap <DC-IP> -u '<USERNAME>' -p '<PASSWORD>' --bloodhound --collection All --dns-server <DC-IP>", example:"nxc ldap 10.10.10.10 -u 'pentest' -p 'HackSmarter123!' --bloodhound --collection All --dns-server 10.10.10.10" },
  { id:'method-2', name:'Method 2 — SharpHound', description:'Run SharpHound directly on an authorized Windows machine.', usage:'.\\SharpHound.exe -c All', example:'PS C:\\Users\\pentest\\Desktop> .\\SharpHound.exe -c All', link:'https://github.com/SpecterOps/SharpHound/releases', linkLabel:'SharpHound releases' },
  { id:'method-3', name:'Method 3 — RustHound', description:'Query Active Directory remotely using a Rust collector and save the output to a directory.', usage:"rusthound -d <DOMAIN> -u '<USERNAME>' -p '<PASSWORD>' -n <DC-IP> -o ./rusthound_output", example:"rusthound -d yggdrasil.hacksmarter -u 'pentest' -p 'HackSmarter123!' -n 10.10.10.10 -o ./rusthound_output", note:'Depending on the installation, the executable may be named rusthound-ce.', link:'https://github.com/g0h4n/RustHound-CE/releases', linkLabel:'RustHound-CE releases' },
  { id:'method-4', name:'Method 4 — bloodhound-python', description:'Collect remotely from Linux using the domain controller hostname and DNS server.', usage:"bloodhound-python -u '<USERNAME>' -p '<PASSWORD>' -d <DOMAIN> -dc <DC-HOSTNAME> -c All -ns <DC-IP>", example:"bloodhound-python -u 'pentest' -p 'HackSmarter123!' -d yggdrasil.hacksmarter -dc midgarddc.yggdrasil.hacksmarter -c All -ns 10.10.10.10", note:'For BloodHound Community Edition, use the compatible CE branch.', link:'https://github.com/dirkjanm/BloodHound.py/tree/bloodhound-ce', linkLabel:'BloodHound.py CE branch' },
  { id:'method-5', name:'Method 5 — bloodyAD', description:'Collect BloodHound-compatible directory data with bloodyAD.', usage:"bloodyad -H <DC-HOSTNAME> -d <DOMAIN> -u '<USERNAME>' -p '<PASSWORD>' get bloodhound", example:"bloodyad -H midgarddc.yggdrasil.hacksmarter -d yggdrasil.hacksmarter -u 'pentest' -p 'HackSmarter123!' get bloodhound", link:'https://github.com/CravateRouge/bloodyAD', linkLabel:'bloodyAD project' }
];
const steps = [
  { title:'2. Extract the archive', usage:'tar -xf <ARCHIVE-NAME>.tar.gz', example:'tar -xf bloodhound-cli-linux-amd64.tar.gz' },
  { title:'3. Make the CLI available system-wide', usage:'sudo mv <EXTRACTED-BINARY> /usr/local/bin/', example:'sudo mv bloodhound-cli /usr/local/bin/' },
  { title:'4. Install and launch BloodHound', usage:'sudo bloodhound-cli install', example:'sudo bloodhound-cli install', note:'Wait for services to become healthy. Save the initial administrator credentials displayed by the CLI.' },
  { title:'5. Retrieve the initial password if needed', usage:'sudo bloodhound-cli config get default_password', example:'sudo bloodhound-cli config get default_password' }
];
---
<!doctype html>
<html lang="en">
<head><BaseHead title="BloodHound Cheatsheet | The Dark Codex" description="Five practical BloodHound collection methods, plus BloodHound Community Edition installation and launch." /></head>
<body>
<Header />
<main class="codex-page">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">PentestBlueprint</a><span>/</span><a href="/dark-codex">The Dark Codex</a><span>/</span><span>BloodHound</span></nav>
  <header class="hero">
    <p class="eyebrow">THE DARK CODEX / ACTIVE DIRECTORY</p>
    <h1>BloodHound<span>.</span></h1>
    <p class="lead">Five practical methods for collecting Active Directory relationship data, followed by installing and launching BloodHound Community Edition up to its login interface.</p>
  </header>
  <img class="hero-img" src="/images/dark-codex/bloodhound.png" alt="BloodHound Dark Codex cover" loading="eager" width="768" height="256" />
  <div class="note"><strong>Scope:</strong> Run these commands only in environments you own or are authorized to assess. The domain, IP addresses, usernames, and passwords are illustrative lab values. Check the installed tool's <code>--help</code> output if CLI syntax differs by version.</div>
  <div class="body-grid">
    <article>
      <section class="section" id="collection">
        <p class="eyebrow">01 / DATA COLLECTION</p>
        <h2>Five collection methods</h2>
        <div class="examples">
          {methods.map(method => (
            <div class="example" id={method.id}>
              <h3>{method.name}</h3>
              <p>{method.description}</p>
              <div class="command-label">Command usage</div>
              <pre><code>{method.usage}</code></pre>
              <div class="command-label">Example</div>
              <pre><code>{method.example}</code></pre>
              {method.note && <p class="hint">{method.note}</p>}
              {method.link && <p class="reference"><a href={method.link} target="_blank" rel="noopener noreferrer">{method.linkLabel} ↗</a></p>}
            </div>
          ))}
        </div>
      </section>
      <section class="section" id="launch">
        <p class="eyebrow">02 / BLOODHOUND CE</p>
        <h2>Installing and launching BloodHound</h2>
        <p>BloodHound Community Edition provides a web interface backed by containers. The BloodHound CLI helps install and start the required services.</p>
        <div class="examples">
          <div class="example">
            <h3>1. Download the CLI</h3>
            <p>Open the <a href="https://github.com/SpecterOps/bloodhound-cli/releases/tag/v0.2.1" target="_blank" rel="noopener noreferrer">BloodHound CLI v0.2.1 release ↗</a> and download <code>bloodhound-cli-linux-amd64.tar.gz</code> for a standard 64-bit Kali Linux installation. The commands below assume Docker is available and the archive is in the current directory.</p>
          </div>
          {steps.map(step => (
            <div class="example">
              <h3>{step.title}</h3>
              {step.usage !== step.example && (
                <>
                  <div class="command-label">Command usage</div>
                  <pre><code>{step.usage}</code></pre>
                </>
              )}
              <div class="command-label">{step.usage === step.example ? 'Command' : 'Example'}</div>
              <pre><code>{step.example}</code></pre>
              {step.note && <p class="hint">{step.note}</p>}
            </div>
          ))}
          <div class="example" id="interface">
            <h3>6. Open the BloodHound interface</h3>
            <div class="command-label">URL</div>
            <pre><code>http://127.0.0.1:8080/ui/login</code></pre>
            <p class="hint">Log in as <code>admin</code> with the generated initial password. You may be prompted to change it on first login.</p>
          </div>
        </div>
      </section>
      <section class="section sources" id="sources">
        <p class="eyebrow">03 / SOURCES & CREDITS</p>
        <h2>Documentation</h2>
        <p>Official project references for checking current options and compatibility.</p>
        <ul>
          <li><a href="https://github.com/SpecterOps/bloodhound-docs" target="_blank" rel="noopener noreferrer">SpecterOps BloodHound documentation ↗</a></li>
          <li><a href="https://github.com/SpecterOps/bloodhound-cli" target="_blank" rel="noopener noreferrer">BloodHound CLI ↗</a></li>
        </ul>
      </section>
    </article>
    <aside class="toc" aria-label="On this page">
      <strong>ON THIS PAGE</strong>
      <a href="#collection">Collection methods</a>
      {methods.map(method => <a href={`#${method.id}`}>{method.name}</a>)}
      <a href="#launch">Installation & launch</a>
      <a href="#interface">Login interface</a>
      <a href="#sources">Sources</a>
    </aside>
  </div>
  <div class="back"><a href="/dark-codex">← Back to The Dark Codex</a></div>
</main>
<Footer />
</body>
</html>
<style>
.codex-page{width:min(1120px,calc(100% - 44px));margin:auto;padding:20px 0 85px;color:#edf4ed}
.crumbs{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:#a1b3a5}
.crumbs a,.sources a,.back a,.reference a,.example a{color:#9cff57;text-decoration:none}
.crumbs a:hover,.sources a:hover,.example a:hover{text-decoration:underline}
.hero{padding:27px 0 20px}
.eyebrow{color:#9cff57;font:700 11px ui-monospace,monospace;letter-spacing:1.7px}
.hero h1{font-size:clamp(40px,6vw,70px);line-height:1.1;letter-spacing:-.045em;margin:14px 0}
.hero h1 span{color:#9cff57}
.lead{max-width:760px;color:#b3c3b8;font-size:16px;line-height:1.75}
.hero-img{display:block;width:100%;max-height:300px;object-fit:cover;border:1px solid #2c4332;border-radius:12px;margin:19px 0 24px}
.body-grid{display:grid;grid-template-columns:minmax(0,1fr) 205px;gap:38px;align-items:start}
.section{margin:0 0 40px;scroll-margin-top:25px}
.section h2{font-size:26px;margin:10px 0 14px}
.section p,.section li{font-size:14px;color:#b8c7ba;line-height:1.8}
.section li{margin:8px 0}
.examples{display:grid;gap:12px}
.example{background:#101612;border:1px solid #2b3b2e;border-radius:10px;padding:17px;min-width:0;scroll-margin-top:22px}
.example h3{font-size:15px;margin:0 0 9px}
.example p{margin:0 0 10px}
.example pre{background:#080d0b;border:1px solid #27372c;border-radius:7px;padding:12px;overflow:auto;margin:0 0 13px}
.example pre:last-child{margin-bottom:0}
.example pre code{color:#c2ffac;font:12px ui-monospace,Consolas,monospace;white-space:pre}
.example p code{color:#c2ffac}
.command-label{color:#d9e8dc;font-weight:700;font-size:12px;margin:12px 0 7px}
.example .hint{margin-top:10px;color:#b8c7ba}
.example .reference{margin:10px 0 0}
.toc{position:sticky;top:22px;background:#101612;border:1px solid #2b3b2e;border-radius:11px;padding:20px;display:flex;flex-direction:column;gap:13px}
.toc strong{color:#9cff57;font:700 11px ui-monospace,monospace;letter-spacing:1px}
.toc a{font-size:12px;color:#c1d0c3;text-decoration:none}
.toc a:hover{color:#9cff57}
.note{border:1px solid #31553b;background:#132018;border-radius:9px;padding:14px 18px;color:#bbd1c1;font-size:13px;line-height:1.7;margin:0 0 28px}
.sources{padding:20px;border:1px solid #2b3b2e;border-radius:10px;background:#101612}
.sources ul{padding-left:20px}
.back{margin-top:26px;padding-top:18px;border-top:1px solid #2b3b2e}
@media(max-width:780px){.body-grid{grid-template-columns:1fr}.toc{position:static;grid-row:1;flex-direction:row;flex-wrap:wrap}.toc strong{width:100%}}
@media(max-width:520px){.codex-page{width:calc(100% - 32px)}.hero-img{margin:12px 0 20px}.section{margin-bottom:32px}}
</style>
