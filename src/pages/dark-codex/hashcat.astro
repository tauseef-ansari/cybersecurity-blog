}th,td{text-align:left;padding:13px;border-bottom:1px solid #263329}th{color:#9cff57;background:#132017}td{color:#c0cdc3}tr:last-child td{border-bottom:0}.hint{padding:14px 18px;border-left:3px solid #9cff57;background:#142018;border-radius:5px;margin-top:18px}.stack{display:grid;gap:14px}.example{padding:19px;border:1px solid #293c2e;border-radius:11px;background:#101612;min-width:0}.example pre{margin:12px 0 0}.example p{margin:5px 0 0}.example-head{display:flex;align-items:center;gap:12px}.mode{font:700 12px ui-monospace,monospace;color:#9cff57;border:1px solid #355c3c;border-radius:6px;padding:6px 9px}.example-head h3{margin:0}.mask-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:18px 0}.mask-item{display:flex;align-items:center;gap:14px;padding:13px;border:1px solid #293c2e;border-radius:8px;background:#101612;font-size:12px;color:#b5c3b8}.mask-item code{font-weight:800}.toc{position:sticky;top:24px;display:flex;flex-direction:column;gap:13px;padding:20px;background:#101612;border:1px solid #293c2e;border-radius:12px}.toc p{font:700 10px ui-monospace,monospace;letter-spacing:1px;color:#9cff57}.toc a{font-size:12px;color:#a6bba9;text-decoration:none}.toc a:hover{color:#9cff57}.back{padding:22px;border-top:1px solid #293c2e}.back a{color:#9cff57;text-decoration:none;font-weight:700}@media(max-width:820px){.layout{grid-template-columns:1fr}.toc{position:static;grid-row:1;display:flex;flex-direction:row;flex-wrap:wrap;gap:10px}.toc p{width:100%}}@media(max-width:560px){.codex-entry{width:calc(100% - 32px)}.credit{padding:20px}.mask-grid{grid-template-columns:1fr}.hero{padding-top:24px}.content section{margin-bottom:42px}}
