
---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />

/* Article heading sizes */
.prose :global(h1) {
  font-size: 1.8rem;
  line-height: 1.3;
  font-weight: 700;
  margin: 32px 0 16px;
}

.prose :global(h2) {
  font-size: 1.5rem;
  line-height: 1.35;
  font-weight: 650;
  margin: 28px 0 14px;
}

.prose :global(h3) {
  font-size: 1.2rem;
  line-height: 1.4;
  font-weight: 600;
  margin: 22px 0 10px;
}

.prose :global(h4) {
  font-size: 1.05rem;
  line-height: 1.4;
  font-weight: 600;
  margin: 18px 0 8px;
}

/* Keep the article's main title distinct */
.title h1 {
  font-size: 2rem;
  line-height: 1.25;
  margin: 12px 0 20px;
}

    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0 24px;
        box-sizing: border-box;
      }

      article {
        width: 100%;
        margin: 0;
        text-align: left;
      }

      .hero-image {
        width: 100%;
        max-width: 900px;
        margin: 32px auto 0;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      .prose {
        width: 100%;
        max-width: 900px;
        margin: 0;
        padding: 32px 0 64px;
        box-sizing: border-box;
        color: rgb(var(--gray-dark));
        text-align: left;
        overflow-wrap: break-word;
      }

      .title {
        margin-bottom: 32px;
        padding: 16px 0;
        text-align: left;
        line-height: 1.3;
      }

      .title h1 {
        margin: 12px 0 20px;
        text-align: left;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.2;
      }

      .date {
        margin-bottom: 12px;
        color: rgb(var(--gray));
        text-align: left;
      }

      .last-updated-on {
        margin-top: 8px;
        font-style: italic;
      }

      .title hr {
        margin: 24px 0 0;
      }

      .prose :global(h1),
      .prose :global(h2),
      .prose :global(h3),
      .prose :global(h4),
      .prose :global(p),
      .prose :global(ul),
      .prose :global(ol),
      .prose :global(li),
      .prose :global(blockquote),
      .prose :global(pre) {
        text-align: left;
      }

      .prose :global(h2) {
        margin-top: 2em;
      }

      .prose :global(p),
      .prose :global(li) {
        line-height: 1.8;
      }

      .prose :global(pre) {
        max-width: 100%;
        overflow-x: auto;
        padding: 20px;
        border-radius: 10px;
      }

      .prose :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 24px 0;
        border-radius: 10px;
      }

      .prose :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
      }

      @media (max-width: 768px) {
        main {
          padding: 0 16px;
        }

        .prose {
          padding: 24px 0 48px;
        }

        .title h1 {
          font-size: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <article>
        <div class="hero-image">
          {heroImage && (
            <img width={1020} height={510} src={heroImage} alt="" />
          )}
        </div>

        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>

            <h1>{title}</h1>
            <hr />
          </div>

          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
