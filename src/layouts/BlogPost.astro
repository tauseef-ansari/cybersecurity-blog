---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
} = Astro.props;

const tocHeadings = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 3
);

const hasToc = tocHeadings.length > 0;
const tocBaseDepth = hasToc
  ? Math.min(...tocHeadings.map((heading) => heading.depth))
  : 1;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />

    <style>
      main {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 32px;
        box-sizing: border-box;
      }

      .article-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(24px, 3vw, 48px);
        align-items: start;
      }

      .article-layout.has-toc {
        grid-template-columns: minmax(0, 1fr) 280px;
      }

      .article-content,
      article {
        width: 100%;
        min-width: 0;
        margin: 0;
        text-align: left;
      }

      .hero-image {
        width: 100%;
        margin: 24px 0 0;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      .prose {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 28px 0 64px;
        box-sizing: border-box;
        color: rgb(var(--gray-dark));
        text-align: left;
        overflow-wrap: break-word;
      }

      .title {
        margin: 0 0 28px;
        padding: 12px 0;
        text-align: left;
        line-height: 1.3;
      }

      .prose .title h1 {
        margin: 12px 0 16px;
        font-size: clamp(1.8rem, 2.3vw, 2.3rem);
        font-weight: 700;
        line-height: 1.25;
        text-align: left;
        text-wrap: balance;
      }

      .date {
        margin-bottom: 12px;
        color: rgb(var(--gray));
        font-size: 0.95rem;
        text-align: left;
      }

      .last-updated-on {
        margin-top: 8px;
        font-style: italic;
      }

      .title hr {
        margin: 20px 0 0;
      }

      /* Markdown content rendered through the slot. */
      .prose :global(h1),
      .prose :global(h2),
      .prose :global(h3),
      .prose :global(h4),
      .prose :global(p),
      .prose :global(ul),
      .prose :global(ol),
      .prose :global(li),
      .prose :global(blockquote),
      .prose :global(pre),
      .prose :global(th),
      .prose :global(td) {
        text-align: left;
      }

      .prose :global(h1[id]),
      .prose :global(h2[id]),
      .prose :global(h3[id]) {
        scroll-margin-top: 28px;
      }

      .prose :global(h1) {
        margin: 36px 0 18px;
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1.3;
      }

      .prose :global(h2) {
        margin: 40px 0 16px;
        font-size: 1.5rem;
        font-weight: 650;
        line-height: 1.35;
      }

      .prose :global(h3) {
        margin: 28px 0 12px;
        font-size: 1.2rem;
        font-weight: 600;
        line-height: 1.4;
      }

      .prose :global(h4) {
        margin: 22px 0 10px;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.4;
      }

      .prose :global(p),
      .prose :global(li) {
        line-height: 1.75;
      }

      .prose :global(p) {
        margin: 0 0 20px;
      }

      .prose :global(ul),
      .prose :global(ol) {
        padding-left: 1.5rem;
        margin: 16px 0 24px;
      }

      .prose :global(li) {
        margin-bottom: 8px;
      }

      .prose :global(pre) {
        width: 100%;
        max-width: 100%;
        margin: 20px 0 28px;
        padding: 18px;
        overflow-x: auto;
        border-radius: 10px;
        box-sizing: border-box;
        white-space: pre;
        font-size: 0.9rem;
        line-height: 1.65;
      }

      .prose :global(pre code) {
        padding: 0;
        border: 0;
        background: transparent;
        font-size: inherit;
        white-space: inherit;
        overflow-wrap: normal;
        word-break: normal;
      }

      .prose :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 24px 0;
        border-radius: 10px;
      }

      .prose :global(table) {
        display: block;
        width: 100%;
        max-width: 100%;
        margin: 24px 0 32px;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.95rem;
      }

      .prose :global(th),
      .prose :global(td) {
        padding: 12px 16px;
        border: 1px solid rgba(150, 170, 150, 0.2);
        vertical-align: top;
        line-height: 1.6;
      }

      .prose :global(th) {
        font-weight: 700;
        background: rgba(120, 140, 120, 0.08);
      }

      .prose :global(blockquote) {
        margin: 24px 0;
        padding: 16px 20px;
        border-left: 3px solid #a3ff5c;
        border-radius: 0 8px 8px 0;
        background: rgba(120, 140, 120, 0.06);
      }

      .prose :global(blockquote p:last-child) {
        margin-bottom: 0;
      }

      .toc {
        position: sticky;
        top: 24px;
        max-height: calc(100dvh - 48px);
        margin-top: 24px;
        padding: 20px;
        overflow-y: auto;
        box-sizing: border-box;
        border: 1px solid rgba(150, 170, 150, 0.25);
        border-radius: 12px;
        background: rgba(120, 140, 120, 0.06);
        scrollbar-width: thin;
      }

      .toc-title {
        margin: 0 0 16px;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .toc-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .toc-item {
        margin: 0 0 12px;
        line-height: 1.5;
      }

      .toc-item:last-child {
        margin-bottom: 0;
      }

      .toc-item a {
        display: block;
        color: inherit;
        opacity: 0.8;
        font-size: 0.88rem;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .toc-item a:hover,
      .toc-item a:focus-visible {
        color: #a3ff5c;
        opacity: 1;
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .toc-indent-1 {
        padding-left: 14px;
      }

      .toc-indent-2 {
        padding-left: 28px;
      }

      .mobile-toc {
        display: none;
      }

      @media (max-width: 1100px) {
        main {
          max-width: 1000px;
        }

        .article-layout,
        .article-layout.has-toc {
          display: block;
        }

        .desktop-toc {
          display: none;
        }

        .mobile-toc {
          display: block;
          width: 100%;
          margin: 24px 0 0;
          padding: 16px 18px;
          box-sizing: border-box;
          border: 1px solid rgba(150, 170, 150, 0.25);
          border-radius: 10px;
          background: rgba(120, 140, 120, 0.06);
        }

        .mobile-toc summary {
          cursor: pointer;
          font-weight: 700;
        }

        .mobile-toc .toc-list {
          margin-top: 18px;
        }
      }

      @media (max-width: 768px) {
        main {
          padding: 0 16px;
        }

        .hero-image {
          margin-top: 20px;
        }

        .prose {
          padding: 20px 0 48px;
        }

        .prose .title h1 {
          font-size: 1.8rem;
        }

        .prose :global(h1) {
          font-size: 1.6rem;
        }

        .prose :global(h2) {
          margin-top: 32px;
          font-size: 1.35rem;
        }

        .prose :global(h3) {
          font-size: 1.15rem;
        }

        .prose :global(pre) {
          padding: 14px;
          font-size: 0.82rem;
        }

        .prose :global(th),
        .prose :global(td) {
          padding: 10px 12px;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <div class:list={['article-layout', { 'has-toc': hasToc }]}>
        <div class="article-content">
          {
            hasToc && (
              <details class="mobile-toc">
                <summary>On this page</summary>
                <nav aria-label="Article table of contents">
                  <ul class="toc-list">
                    {tocHeadings.map((heading) => (
                      <li
                        class={`toc-item toc-indent-${heading.depth - tocBaseDepth}`}
                      >
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </details>
            )
          }

          <article>
            {
              heroImage && (
                <div class="hero-image">
                  <img
                    width={1020}
                    height={510}
                    src={heroImage}
                    alt=""
                  />
                </div>
              )
            }

            <div class="prose">
              <div class="title">
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {
                    updatedDate && (
                      <div class="last-updated-on">
                        Last updated on <FormattedDate date={updatedDate} />
                      </div>
                    )
                  }
                </div>

                <h1>{title}</h1>
                <hr />
              </div>

              <slot />
            </div>
          </article>
        </div>

        {
          hasToc && (
            <aside
              class="toc desktop-toc"
              aria-label="Article table of contents"
            >
              <h2 class="toc-title">On this page</h2>

              <nav aria-label="Jump to section">
                <ul class="toc-list">
                  {tocHeadings.map((heading) => (
                    <li
                      class={`toc-item toc-indent-${heading.depth - tocBaseDepth}`}
                    >
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </aside>
          )
        }
      </div>
    </main>

    <Footer />
  </body>
</html>
