---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 3);
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0 24px;
        box-sizing: border-box;
      }

      .article-layout {
        display: grid;
        grid-template-columns: minmax(0, 900px) minmax(220px, 280px);
        gap: clamp(24px, 4vw, 64px);
        align-items: start;
        justify-content: start;
      }

      article {
        width: 100%;
        margin: 0;
        text-align: left;
      }

      .article-content { min-width: 0; }

      .toc {
        position: sticky;
        top: 24px;
        max-height: calc(100vh - 48px);
        overflow-y: auto;
        margin-top: 32px;
        padding: 20px;
        border: 1px solid rgba(150, 170, 150, .25);
        border-radius: 12px;
        background: rgba(120, 140, 120, .06);
      }
      .toc-title {
        margin: 0 0 14px;
        font-size: .9rem;
        font-weight: 700;
        letter-spacing: .03em;
      }
      .toc-list { list-style: none; padding: 0; margin: 0; }
      .toc-item { margin: 0 0 9px; line-height: 1.45; }
      .toc-item a { color: inherit; opacity: .8; text-decoration: none; font-size: .88rem; overflow-wrap: anywhere; }
      .toc-item a:hover, .toc-item a:focus-visible { opacity: 1; text-decoration: underline; }
      .toc-level-2 { padding-left: 14px; }
      .toc-level-3 { padding-left: 28px; }
      .mobile-toc { display: none; }
      .prose :global(h1[id]),
      .prose :global(h2[id]),
      .prose :global(h3[id]) { scroll-margin-top: 24px; }

      .hero-image {
        width: 100%;
        max-width: 900px;
        margin: 24px 0 0;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      .prose {
        width: 100%;
        max-width: 900px;
        margin: 0;
        padding: 28px 0 64px;
        box-sizing: border-box;
        color: rgb(var(--gray-dark));
        text-align: left;
        overflow-wrap: break-word;
      }

      .title {
        margin: 0 0 28px;
        padding: 12px 0;
        text-align: left;
        line-height: 1.3;
      }

      .title h1 {
        margin: 12px 0 16px;
        font-size: 2rem;
        line-height: 1.25;
        text-align: left;
      }

      .date {
        margin-bottom: 12px;
        color: rgb(var(--gray));
        text-align: left;
      }

      .last-updated-on {
        margin-top: 8px;
        font-style: italic;
      }

      .title hr {
        margin: 20px 0 0;
      }

      /* Markdown headings are rendered through <slot />. */
      .prose :global(h1),
      .prose :global(h2),
      .prose :global(h3),
      .prose :global(h4),
      .prose :global(p),
      .prose :global(ul),
      .prose :global(ol),
      .prose :global(li),
      .prose :global(blockquote),
      .prose :global(pre) {
        text-align: left;
      }

      .prose :global(h1) {
        font-size: 1.8rem;
        line-height: 1.3;
        font-weight: 700;
        margin: 32px 0 16px;
      }

      .prose :global(h2) {
        font-size: 1.5rem;
        line-height: 1.35;
        font-weight: 650;
        margin: 28px 0 14px;
      }

      .prose :global(h3) {
        font-size: 1.2rem;
        line-height: 1.4;
        font-weight: 600;
        margin: 22px 0 10px;
      }

      .prose :global(h4) {
        font-size: 1.05rem;
        line-height: 1.4;
        font-weight: 600;
        margin: 18px 0 8px;
      }

      .prose :global(p),
      .prose :global(li) {
        line-height: 1.75;
      }

      .prose :global(pre) {
        max-width: 100%;
        overflow-x: auto;
        padding: 18px;
        border-radius: 10px;
        box-sizing: border-box;
        white-space: pre;
      }

      .prose :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 24px 0;
        border-radius: 10px;
      }

      .prose :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
      }

      @media (max-width: 1100px) {
        .article-layout { display: block; }
        .desktop-toc { display: none; }
        .mobile-toc {
          display: block;
          max-width: 900px;
          margin: 20px 0 0;
          padding: 14px 18px;
          border: 1px solid rgba(150, 170, 150, .25);
          border-radius: 10px;
        }
        .mobile-toc summary { cursor: pointer; font-weight: 700; }
        .mobile-toc .toc-list { margin-top: 14px; }
      }

      @media (max-width: 768px) {
        main {
          padding: 0 16px;
        }

        .prose {
          padding: 20px 0 48px;
        }

        .title h1 {
          font-size: 1.8rem;
        }

        .prose :global(h1) {
          font-size: 1.6rem;
        }

        .prose :global(h2) {
          font-size: 1.35rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <div class="article-layout">
        <div class="article-content">
          {tocHeadings.length > 0 && (
            <details class="mobile-toc">
              <summary>On this page</summary>
              <nav aria-label="Article table of contents">
                <ul class="toc-list">
                  {tocHeadings.map((heading) => (
                    <li class={`toc-item toc-level-${heading.depth}`}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          )}
          <article>
            {heroImage && (
              <div class="hero-image">
                <img width={1020} height={510} src={heroImage} alt="" />
              </div>
            )}
            <div class="prose">
              <div class="title">
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
                <h1>{title}</h1>
                <hr />
              </div>
              <slot />
            </div>
          </article>
        </div>
        {tocHeadings.length > 0 && (
          <aside class="toc desktop-toc" aria-label="Article table of contents">
            <h2 class="toc-title">On this page</h2>
            <nav aria-label="Jump to section">
              <ul class="toc-list">
                {tocHeadings.map((heading) => (
                  <li class={`toc-item toc-level-${heading.depth}`}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
